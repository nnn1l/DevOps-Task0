REPO_URL=git@github.com:YOUR_USERNAME/DevOps-Task0.git

# ==========================================
# Application Configuration (Frontend & Backend)
# ==========================================
# BackEnd Port (FastAPI / Node.js)
BACKEND_PORT=8000

# FrontEnd Port (React / Vue)
FRONTEND_PORT=3000

# Environment (development / production)
ENVIRONMENT=development

# Database Credentials
DB_HOST=your_host
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_PORT=your_db_port

# Backend Credentials
SECRET_KEY=your_secret_key
DEBUG=False
ALLOWED_HOSTS=*

# Frontend Credentials
VITE_API_BASE_URL=http://localhost/api
VITE_WEBSOCKET_BASE_URL=ws://localhost/ws